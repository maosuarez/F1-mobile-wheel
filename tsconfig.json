{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
